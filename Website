+"use client";
+
+import { useEffect, useState } from "react";
+import { useSearchParams } from "next/navigation";
+import { Card } from "@/components/Card";
+import { Button } from "@/components/Button";
+import { EmptyState } from "@/components/EmptyState";
+import type { TicketDetails } from "@/types";
+import { addToWallet } from "@/services/wallet";
+
+export function TicketContent() {
+  const params = useSearchParams();
+  const bookingId = params.get("bookingId");
+  const [ticket, setTicket] = useState<TicketDetails | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | undefined>();
+  const [walletStatus, setWalletStatus] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (!bookingId) return;
+    let mounted = true;
+    async function loadTicket() {
+      setLoading(true);
+      setError(undefined);
+      try {
+        const response = await fetch(`/api/ticket?bookingId=${bookingId}`, { cache: "no-store" });
+        if (!response.ok) {
+          throw new Error("Ticket konnte nicht geladen werden");
+        }
+        const data = await response.json();
+        if (mounted) {
+          setTicket(data.ticket);
+        }
+      } catch (err) {
+        if (mounted) {
+          setError((err as Error).message);
+        }
+      } finally {
+        if (mounted) {
+          setLoading(false);
+        }
+      }
+    }
+
+    loadTicket();
+    return () => {
+      mounted = false;
+    };
+  }, [bookingId]);
+
+  async function handleWallet() {
+    if (!ticket) return;
+    setWalletStatus("Wird hinzugefügt...");
+    const result = await addToWallet(ticket.bookingId);
+    if (result.success) {
+      setWalletStatus("Zum Wallet hinzugefügt");
+    }
+  }
+
+  if (!bookingId) {
+    return <EmptyState title="Keine Buchung" description="Bitte gib eine gültige Buchungsnummer an." />;
+  }
+
+  if (loading) {
+    return <Card className="h-72 animate-pulse" />;
+  }
+
+  if (error || !ticket) {
+    return <EmptyState title="Ticket nicht verfügbar" description={error ?? "Versuche es später erneut."} />;
+  }
+
+  return (
+    <Card className="space-y-6 bg-tint/40">
+      <div className="flex flex-wrap items-center justify-between gap-4">
+        <div>
+          <p className="text-sm uppercase tracking-wide text-muted">Buchungsnummer</p>
+          <h2 className="text-2xl font-semibold text-foreground">{ticket.bookingId}</h2>
+        </div>
+        <Button variant="outline" onClick={() => window.open(ticket.pdfUrl, "_blank")}>PDF laden</Button>
+      </div>
+      <div className="grid gap-6 md:grid-cols-[200px_1fr] md:items-center">
+        <div className="flex justify-center">
+          <img src={ticket.qrData} alt="Ticket QR Code" className="h-48 w-48 rounded-2xl border border-border bg-white p-4" />
+        </div>
+        <div className="space-y-3 text-sm text-foreground/80">
+          <p className="text-lg font-semibold text-foreground">{ticket.route}</p>
+          <p>
+            <span className="font-medium text-foreground">Abfahrt:</span> {ticket.departure}
+          </p>
+          <p>
+            <span className="font-medium text-foreground">Ankunft:</span> {ticket.arrival}
+          </p>
+          <p>
+            <span className="font-medium text-foreground">Platz:</span> Wagen {ticket.coach}, Sitz {ticket.seat}
+          </p>
+          <Button onClick={handleWallet}>{walletStatus ?? "Zum Wallet hinzufügen"}</Button>
+        </div>
+      </div>
+      <div className="rounded-2xl bg-white/70 p-4 text-sm text-foreground/80">
+        <h3 className="text-sm font-semibold text-foreground">EU-Fahrgastrechte</h3>
+        <p className="mt-1">
+          Bei Verspätungen ab 60 Minuten hast du Anspruch auf Entschädigung gemäß EU-Verordnung 1371/2007.
+          Bewahre dein Ticket auf und reiche es beim Anbieter ein.
+        </p>
+      </div>
+    </Card>
+  );
+}
