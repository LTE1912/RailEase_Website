@@ -0,0 +1,67 @@
+import { addMinutes, formatISO, parseISO } from "date-fns";
+import { randomUUID } from "crypto";
+import type { Offer, Segment, TravelClass } from "@/types";
+import type { SearchFormValues } from "@/lib/validation/search";
+
+const PROVIDERS = [
+  { name: "EuroRail", logo: "https://images.unsplash.com/photo-1520012218364-950b698f72c7?w=200" },
+  { name: "TransContinental", logo: "https://images.unsplash.com/photo-1521207418485-99c705420785?w=200" },
+  { name: "RailExpress", logo: "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=200" }
+];
+
+const DURATIONS = [160, 185, 210, 240, 305, 325, 360];
+
+const TRANSFER_OPTIONS = [0, 0, 1, 1, 2];
+
+const CLASSES: Record<TravelClass, number> = {
+  economy: 1,
+  comfort: 1.25,
+  first: 1.65,
+};
+
+export interface AggregatedOfferInput extends SearchFormValues {}
+
+export async function fetchAggregatedOffers(params: AggregatedOfferInput): Promise<Offer[]> {
+  const seedDate = parseISO(params.departureDate);
+  const offers: Offer[] = [];
+
+  for (let i = 0; i < 8; i += 1) {
+    const provider = PROVIDERS[i % PROVIDERS.length];
+    const transfers = TRANSFER_OPTIONS[Math.floor(Math.random() * TRANSFER_OPTIONS.length)];
+    const durationMinutes = DURATIONS[Math.floor(Math.random() * DURATIONS.length)];
+    const departureOffset = Math.floor(Math.random() * 9) * 25;
+    const departure = addMinutes(seedDate, departureOffset);
+    const arrival = addMinutes(departure, durationMinutes);
+    const basePrice = 39 + durationMinutes * 0.4 + transfers * 12;
+    const price = Math.round(basePrice * CLASSES[params.travelClass]);
+
+    const segments: Segment[] = Array.from({ length: transfers + 1 }).map((_, idx) => {
+      const segDeparture = idx === 0 ? departure : addMinutes(departure, durationMinutes * (idx / (transfers + 1)));
+      const segArrival = idx === transfers ? arrival : addMinutes(segDeparture, durationMinutes / (transfers + 1));
+      return {
+        from: idx === 0 ? params.from : `${params.from} Umstieg ${idx}`,
+        to: idx === transfers ? params.to : `${params.to} Umstieg ${idx + 1}`,
+        departure: formatISO(segDeparture),
+        arrival: formatISO(segArrival),
+        train: `IC ${Math.floor(Math.random() * 800) + 100}`,
+      };
+    });
+
+    offers.push({
+      id: randomUUID(),
+      provider: provider.name,
+      providerLogo: provider.logo,
+      price,
+      currency: "EUR",
+      departure: formatISO(departure),
+      arrival: formatISO(arrival),
+      durationMinutes,
+      transfers,
+      segments,
+      travelClass: params.travelClass,
+      direct: transfers === 0,
+    });
+  }
+
+  return offers;
+}
