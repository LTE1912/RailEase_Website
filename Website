+import { NextResponse } from "next/server";
+import { Buffer } from "buffer";
+import { generateTicketPdf } from "@/services/pdf";
+
+function createQrData(bookingId: string) {
+  return `data:image/svg+xml;base64,${Buffer.from(`<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><rect width='200' height='200' fill='#f9f5f2'/><text x='50%' y='50%' dominant-baseline='middle' text-anchor='middle' font-size='20' fill='#bc1a25'>QR</text></svg>`).toString("base64")}`;
+}
+
+export async function GET(request: Request) {
+  const url = new URL(request.url);
+  const bookingId = url.searchParams.get("bookingId");
+
+  if (!bookingId) {
+    return NextResponse.json({ error: "bookingId erforderlich" }, { status: 400 });
+  }
+
+  const pdfUrl = await generateTicketPdf(bookingId);
+
+  const ticket = {
+    bookingId,
+    passengerName: "RailEase Gast",
+    route: "Berlin Hbf → Paris Gare du Nord",
+    departure: "12.06.2024 • 08:46",
+    arrival: "12.06.2024 • 16:05",
+    coach: "12",
+    seat: "46A",
+    qrData: createQrData(bookingId),
+    pdfUrl,
+  };
+
+  return NextResponse.json({ ticket });
+}
