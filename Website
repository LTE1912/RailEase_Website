+        <input
+          type="checkbox"
+          className="h-5 w-5 rounded border border-border text-primary focus-visible:ring-primary"
+          checked={state.directOnly}
+          onChange={(event) => setState((prev) => ({ ...prev, directOnly: event.target.checked }))}
+        />
