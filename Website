@@ -0,0 +1,113 @@
+"use client";
+
+import { useEffect, useMemo, useState } from "react";
+import { useSearchParams } from "next/navigation";
+import { Filters, type FilterState } from "@/components/Filters";
+import { ResultCard } from "@/components/ResultCard";
+import { Skeleton } from "@/components/Skeleton";
+import { EmptyState } from "@/components/EmptyState";
+import { useSearchStore } from "@/state/searchStore";
+import type { Offer } from "@/types";
+import type { SearchFormValues } from "@/lib/validation/search";
+
+export function ResultsContent() {
+  const params = useSearchParams();
+  const [filteredOffers, setFilteredOffers] = useState<Offer[]>([]);
+  const { setResults, setLoading, setError, results, loading, error, setCriteria } = useSearchStore();
+
+  useEffect(() => {
+    const controller = new AbortController();
+    async function fetchResults() {
+      setLoading(true);
+      setError(undefined);
+      try {
+        const query = params.toString();
+        if (params.size > 0) {
+          const criteria = Object.fromEntries(params.entries());
+          setCriteria({
+            from: String(criteria.from ?? ""),
+            to: String(criteria.to ?? ""),
+            departureDate: String(criteria.departureDate ?? ""),
+            returnDate: criteria.returnDate ? String(criteria.returnDate) : "",
+            passengers: criteria.passengers ? Number(criteria.passengers) : 1,
+            travelClass: (criteria.travelClass as SearchFormValues["travelClass"]) ?? "economy",
+            directOnly: criteria.directOnly === "true",
+          });
+        }
+        const response = await fetch(`/api/search?${query}`, {
+          signal: controller.signal,
+          cache: "no-store",
+        });
+        if (!response.ok) {
+          throw new Error("Fehler beim Laden der Angebote");
+        }
+        const data = await response.json();
+        setResults(data.offers ?? []);
+      } catch (err) {
+        if ((err as Error).name === "AbortError") return;
+        setError((err as Error).message);
+      } finally {
+        setLoading(false);
+      }
+    }
+
+    fetchResults();
+    return () => controller.abort();
+  }, [params, setCriteria, setError, setLoading, setResults]);
+
+  const [filterState, setFilterState] = useState<FilterState>({ sortBy: "price", directOnly: false });
+
+  useEffect(() => {
+    let data = [...results];
+    if (filterState.directOnly) {
+      data = data.filter((offer) => offer.direct);
+    }
+    data.sort((a, b) => {
+      switch (filterState.sortBy) {
+        case "duration":
+          return a.durationMinutes - b.durationMinutes;
+        case "departure":
+          return new Date(a.departure).getTime() - new Date(b.departure).getTime();
+        case "arrivals":
+          return new Date(a.arrival).getTime() - new Date(b.arrival).getTime();
+        case "price":
+        default:
+          return a.price - b.price;
+      }
+    });
+    setFilteredOffers(data);
+  }, [filterState, results]);
+
+  const skeletons = useMemo(() => Array.from({ length: 4 }), []);
+
+  return (
+    <div className="grid gap-6 md:grid-cols-[1fr_320px]">
+      <div className="space-y-4" aria-live="polite">
+        {loading
+          ? skeletons.map((_, idx) => <Skeleton key={idx} className="h-40 w-full" />)
+          : null}
+        {!loading && error ? (
+          <EmptyState title="Ups!" description={error} />
+        ) : null}
+        {!loading && !error && filteredOffers.length === 0 ? (
+          <EmptyState
+            title="Keine Verbindungen gefunden"
+            description="Passe deine Filter an oder prüfe ein anderes Datum."
+          />
+        ) : null}
+        {!loading && !error
+          ? filteredOffers.map((offer) => <ResultCard key={offer.id} offer={offer} />)
+          : null}
+      </div>
+      <aside className="space-y-4">
+        <Filters onChange={setFilterState} initialDirectOnly={params.get("directOnly") === "true"} />
+        <div className="rounded-2xl bg-tint/40 p-4 text-sm text-foreground/80">
+          <p className="font-semibold text-foreground">Hinweis</p>
+          <p className="mt-1">
+            Preise werden alle 60 Sekunden aktualisiert. Verfügbarkeit kann variieren.
+          </p>
+        </div>
+      </aside>
+    </div>
+  );
+}
