+export function formatDuration(minutes: number) {
+  const hours = Math.floor(minutes / 60);
+  const remaining = minutes % 60;
+  if (hours <= 0) {
+    return `${remaining} Min`;
+  }
+  if (remaining === 0) {
+    return `${hours} Std`;
+  }
+  return `${hours} Std ${remaining} Min`;
+}
