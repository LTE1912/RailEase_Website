+"use client";
+
+import { useState, useEffect } from "react";
+import { Button } from "./Button";
+import { Select } from "./Select";
+
+export type SortOption = "price" | "duration" | "departure" | "arrivals";
+
+export interface FilterState {
+  sortBy: SortOption;
+  directOnly: boolean;
+}
+
+interface FiltersProps {
+  onChange: (state: FilterState) => void;
+  initialDirectOnly?: boolean;
+}
+
+export function Filters({ onChange, initialDirectOnly = false }: FiltersProps) {
+  const [state, setState] = useState<FilterState>({ sortBy: "price", directOnly: initialDirectOnly });
+
+  useEffect(() => {
+    onChange(state);
+  }, [state, onChange]);
+
+  return (
+    <div className="flex flex-col gap-3 rounded-2xl border border-border bg-white p-4 shadow-soft">
+      <div>
+        <label className="mb-1 block text-sm font-medium text-foreground">Sortieren nach</label>
+        <Select
+          value={state.sortBy}
+          onChange={(event) => setState((prev) => ({ ...prev, sortBy: event.target.value as SortOption }))}
+        >
+          <option value="price">Preis</option>
+          <option value="duration">Dauer</option>
+          <option value="departure">Abfahrt</option>
+          <option value="arrivals">Ankunft</option>
+        </Select>
+      </div>
